@model List<Coupon>
@{
    ViewData["Title"] = "Mã giảm giá";
    var now = DateTime.Now;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Mã giảm giá</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Tạo mã</a>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Mã</th><th>Mô tả</th><th>Mức giảm</th><th class="text-end">Đơn tối thiểu</th><th class="text-center">Đã dùng</th><th>Hiệu lực</th><th class="text-center">Trạng thái</th><th class="text-end" style="width:160px"></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                var label = !c.IsActive ? ("Tắt", "bg-secondary") : c.EndDate < now ? ("Hết hạn", "bg-dark") : (c.UsageLimit.HasValue && c.UsedCount >= c.UsageLimit) ? ("Hết lượt", "bg-warning text-dark") : ("Đang chạy", "bg-success");
                <tr>
                    <td><code class="fs-6">@c.Code</code></td>
                    <td class="small">@c.Description</td>
                    <td>@(c.DiscountType == DiscountType.Percent ? c.DiscountValue + "%" + (c.MaxDiscountAmount.HasValue ? " (tối đa " + c.MaxDiscountAmount.Value.ToString("N0") + ")" : "") : c.DiscountValue.ToString("N0") + " đ")</td>
                    <td class="text-end">@c.MinOrderAmount.ToString("N0")</td>
                    <td class="text-center">@c.UsedCount@(c.UsageLimit.HasValue ? " / " + c.UsageLimit : "")</td>
                    <td class="small">@c.StartDate.ToString("dd/MM/yyyy") → @c.EndDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center"><span class="badge @label.Item2">@label.Item1</span></td>
                    <td class="text-end">
                        <form asp-action="ToggleActive" asp-route-id="@c.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" title="Bật/tắt"><i class="bi bi-power"></i></button></form>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Xóa mã @c.Code?"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">Chưa có mã giảm giá.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
