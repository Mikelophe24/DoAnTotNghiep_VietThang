@model CouponFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa mã giảm giá" : "Tạo mã giảm giá";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="card" style="max-width:720px">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row">
            <div class="col-md-5 mb-3"><label asp-for="Code" class="form-label required"></label><input asp-for="Code" class="form-control text-uppercase" placeholder="VT10" /><span asp-validation-for="Code" class="text-danger small"></span></div>
            <div class="col-md-7 mb-3"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" placeholder="Hiển thị cho khách" /></div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="DiscountType" class="form-label"></label>
                <select asp-for="DiscountType" class="form-select" id="dtype"><option value="1">Giảm theo %</option><option value="2">Giảm số tiền (đ)</option></select></div>
            <div class="col-md-4 mb-3"><label asp-for="DiscountValue" class="form-label required"></label><input asp-for="DiscountValue" type="number" min="1" class="form-control" /><span asp-validation-for="DiscountValue" class="text-danger small"></span></div>
            <div class="col-md-4 mb-3" id="max-wrap"><label asp-for="MaxDiscountAmount" class="form-label"></label><input asp-for="MaxDiscountAmount" type="number" min="0" step="1000" class="form-control" /></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="MinOrderAmount" class="form-label"></label><input asp-for="MinOrderAmount" type="number" min="0" step="1000" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="UsageLimit" class="form-label"></label><input asp-for="UsageLimit" type="number" min="1" class="form-control" /></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger small"></span></div>
        </div>
        <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="card-footer"><button class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button></div>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        const dt = document.getElementById('dtype'), mw = document.getElementById('max-wrap');
        const sync = () => mw.style.visibility = dt.value === '1' ? 'visible' : 'hidden';
        dt.addEventListener('change', sync); sync();
    </script>
}
