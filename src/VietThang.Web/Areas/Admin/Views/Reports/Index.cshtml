@model ReportViewModel
@{
    ViewData["Title"] = "Thống kê báo cáo";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Thống kê báo cáo</h1>
    <a class="btn btn-outline-success" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel"></i> Xuất Excel đơn hàng</a>
</div>

<form method="get" class="card card-body mb-3" id="filter">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label small text-muted">Từ ngày</label><input type="date" name="from" id="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label small text-muted">Đến ngày</label><input type="date" name="to" id="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label small text-muted">Nhóm doanh thu theo</label><select name="groupBy" class="form-select"><option value="day" selected="@(Model.GroupBy == "day")">Ngày</option><option value="month" selected="@(Model.GroupBy == "month")">Tháng</option></select></div>
        <div class="col-md-6 d-flex flex-wrap gap-1 align-items-end">
            <button class="btn btn-primary"><i class="bi bi-funnel"></i> Xem</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="today">Hôm nay</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="7">7 ngày</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="30">30 ngày</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="month">Tháng này</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="year">Năm nay</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Doanh thu</div><div class="fs-5 fw-bold">@Model.Revenue.ToString("N0") đ</div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Lợi nhuận gộp</div><div class="fs-5 fw-bold text-success">@Model.GrossProfit.ToString("N0") đ</div><div class="small text-muted">@(Model.Revenue == 0 ? 0 : Math.Round(Model.GrossProfit / Model.Revenue * 100))% doanh thu</div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Đơn hoàn thành / tổng</div><div class="fs-5 fw-bold">@Model.CompletedOrders <span class="text-muted fs-6">/ @Model.TotalOrders</span></div><div class="small text-muted">Hủy: @Model.CancelledOrders</div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Giá trị đơn TB</div><div class="fs-5 fw-bold">@Model.AverageOrderValue.ToString("N0") đ</div><div class="small text-muted">@Model.ItemsSold sản phẩm bán ra</div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Khách mới</div><div class="fs-5 fw-bold">@Model.NewCustomers</div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card h-100 @(Model.LowStockCount > 0 ? "border-danger" : "")"><div class="card-body"><div class="text-muted small">Tồn kho hiện tại</div><div class="fs-5 fw-bold">@Model.StockUnits.ToString("N0")</div><div class="small text-muted">@Model.StockValue.ToString("N0") đ · sắp hết: @Model.LowStockCount</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8"><div class="card h-100"><div class="card-header fw-semibold">Doanh thu theo @(Model.GroupBy == "month" ? "tháng" : "ngày") (đơn hoàn thành)</div><div class="card-body"><canvas id="c-revenue" height="110"></canvas></div></div></div>
    <div class="col-lg-4"><div class="card h-100"><div class="card-header fw-semibold">Đơn hàng theo trạng thái</div><div class="card-body"><canvas id="c-status"></canvas></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Top 10 sản phẩm bán chạy (số lượng)</div><div class="card-body"><canvas id="c-top" height="200"></canvas></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Doanh thu theo nhóm hàng</div><div class="card-body"><canvas id="c-category" height="200"></canvas></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Lợi nhuận gộp theo tháng</div><div class="card-body"><canvas id="c-profit" height="140"></canvas></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header fw-semibold">Khách hàng mới theo tháng</div><div class="card-body"><canvas id="c-customers" height="140"></canvas></div></div></div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card"><div class="card-header fw-semibold">Bảng sản phẩm bán chạy</div>
            <table class="table table-sm mb-0"><thead class="table-light"><tr><th>#</th><th>Sản phẩm</th><th class="text-end">SL</th><th class="text-end">Doanh thu</th></tr></thead><tbody>
            @{ int i = 1; }
            @foreach (var p in Model.TopProducts) { <tr><td>@(i++)</td><td>@p.Name</td><td class="text-end">@p.Quantity</td><td class="text-end">@p.Value.ToString("N0")</td></tr> }
            @if (!Model.TopProducts.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">Không có dữ liệu trong kỳ.</td></tr> }
            </tbody></table></div>
    </div>
    <div class="col-lg-6">
        <div class="card"><div class="card-header fw-semibold">Bảng doanh thu theo nhóm hàng</div>
            <table class="table table-sm mb-0"><thead class="table-light"><tr><th>Nhóm</th><th class="text-end">SL</th><th class="text-end">Doanh thu</th><th class="text-end">Tỷ trọng</th></tr></thead><tbody>
            @{ var totalCat = Model.CategoryRevenue.Sum(c => c.Value); }
            @foreach (var c in Model.CategoryRevenue) { <tr><td>@c.Name</td><td class="text-end">@c.Quantity</td><td class="text-end">@c.Value.ToString("N0")</td><td class="text-end">@(totalCat == 0 ? 0 : Math.Round(c.Value / totalCat * 100, 1))%</td></tr> }
            @if (!Model.CategoryRevenue.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">Không có dữ liệu trong kỳ.</td></tr> }
            </tbody></table></div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    const data = @Html.Raw((string)ViewBag.ChartJson);
    const vnd = v => v.toLocaleString('vi-VN') + ' đ';
    const palette = ['#1F3A5F', '#F2C14E', '#D7263D', '#3D8B6E', '#7B1E3A', '#4F81BD', '#9AA0A6', '#98D8C8', '#8E6C9E', '#D9C3A5'];

    new Chart(document.getElementById('c-revenue'), {
        type: 'line',
        data: { labels: data.revenue.map(p => p.label), datasets: [{ label: 'Doanh thu', data: data.revenue.map(p => p.value), borderColor: '#1F3A5F', backgroundColor: 'rgba(31,58,95,.12)', fill: true, tension: .3, pointRadius: 3 }] },
        options: { plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => vnd(c.parsed.y) + ' · ' + data.revenue[c.dataIndex].count + ' đơn' } } }, scales: { y: { ticks: { callback: v => (v / 1000000).toFixed(1) + ' tr' } } } }
    });
    new Chart(document.getElementById('c-status'), {
        type: 'doughnut',
        data: { labels: data.status.map(s => s.name), datasets: [{ data: data.status.map(s => s.value), backgroundColor: ['#F2C14E', '#4F81BD', '#1F3A5F', '#3D8B6E', '#9AA0A6'] }] },
        options: { plugins: { legend: { position: 'bottom' } } }
    });
    new Chart(document.getElementById('c-top'), {
        type: 'bar',
        data: { labels: data.top.map(p => p.name), datasets: [{ label: 'Số lượng', data: data.top.map(p => p.quantity), backgroundColor: '#1F3A5F' }] },
        options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.parsed.x + ' sp · ' + vnd(data.top[c.dataIndex].value) } } } }
    });
    new Chart(document.getElementById('c-category'), {
        type: 'pie',
        data: { labels: data.category.map(c => c.name), datasets: [{ data: data.category.map(c => c.value), backgroundColor: palette }] },
        options: { plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => c.label + ': ' + vnd(c.parsed) } } } }
    });
    new Chart(document.getElementById('c-profit'), {
        type: 'bar',
        data: { labels: data.profit.map(p => p.label), datasets: [{ label: 'Doanh thu', data: data.profit.map(p => p.revenue), backgroundColor: 'rgba(31,58,95,.35)' }, { label: 'Lợi nhuận gộp', data: data.profit.map(p => p.value), backgroundColor: '#3D8B6E' }] },
        options: { plugins: { tooltip: { callbacks: { label: c => c.dataset.label + ': ' + vnd(c.parsed.y) } } }, scales: { y: { ticks: { callback: v => (v / 1000000).toFixed(1) + ' tr' } } } }
    });
    new Chart(document.getElementById('c-customers'), {
        type: 'line',
        data: { labels: data.customers.map(p => p.label), datasets: [{ label: 'Khách mới', data: data.customers.map(p => p.value), borderColor: '#D7263D', backgroundColor: 'rgba(215,38,61,.12)', fill: true, tension: .3 }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });

    const fmt = d => d.toISOString().slice(0, 10);
    document.querySelectorAll('[data-range]').forEach(b => b.addEventListener('click', () => {
        const today = new Date(); let from = new Date(today), gb = 'day';
        switch (b.dataset.range) {
            case 'today': break;
            case '7': from.setDate(today.getDate() - 6); break;
            case '30': from.setDate(today.getDate() - 29); break;
            case 'month': from = new Date(today.getFullYear(), today.getMonth(), 1); break;
            case 'year': from = new Date(today.getFullYear(), 0, 1); gb = 'month'; break;
        }
        document.getElementById('from').value = fmt(from);
        document.getElementById('to').value = fmt(today);
        document.querySelector('[name="groupBy"]').value = gb;
        document.getElementById('filter').submit();
    }));
</script>
}
