@model VietThang.Web.ViewModels.Admin.ColorFormViewModel
@{
    ViewData["Title"] = "Màu sắc";
    var colors = (List<Color>)ViewBag.Colors;
    var usage = (Dictionary<int, int>)ViewBag.UsageCounts;
}
<h1 class="h4 mb-3">Màu sắc</h1>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>Màu</th><th>Mã màu</th><th class="text-center">Biến thể dùng</th><th class="text-end" style="width:200px"></th></tr></thead>
                <tbody>
                @foreach (var c in colors)
                {
                    <tr>
                        <td><span class="color-dot" style="background:@(c.HexCode ?? "#fff")"></span> @c.Name</td>
                        <td><code>@c.HexCode</code></td>
                        <td class="text-center">@(usage.TryGetValue(c.Id, out var n) ? n : 0)</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-edit-id="@c.Id" data-edit-name="@c.Name" data-edit-hex="@c.HexCode"><i class="bi bi-pencil"></i></button>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Xóa màu '@c.Name'?">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6" id="form-title">Thêm màu</h2>
                <form asp-action="Save" method="post" id="color-form">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required"></label>
                        <input asp-for="Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="HexCode" class="form-label"></label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color" id="hex-picker" value="@Model.HexCode" />
                            <input asp-for="HexCode" class="form-control" />
                        </div>
                    </div>
                    <button class="btn btn-primary w-100" type="submit"><i class="bi bi-check-lg"></i> Lưu</button>
                    <button class="btn btn-link w-100 btn-sm" type="button" id="reset-form">Làm mới form</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    const form = document.getElementById('color-form');
    const picker = document.getElementById('hex-picker');
    const hex = form.querySelector('[name="HexCode"]');
    picker.addEventListener('input', () => hex.value = picker.value.toUpperCase());
    hex.addEventListener('input', () => { if (/^#[0-9a-fA-F]{6}$/.test(hex.value)) picker.value = hex.value; });
    document.querySelectorAll('[data-edit-id]').forEach(btn => btn.addEventListener('click', () => {
        form.querySelector('[name="Id"]').value = btn.dataset.editId;
        form.querySelector('[name="Name"]').value = btn.dataset.editName;
        hex.value = btn.dataset.editHex || '#FFFFFF';
        picker.value = hex.value;
        document.getElementById('form-title').textContent = 'Sửa màu: ' + btn.dataset.editName;
    }));
    document.getElementById('reset-form').addEventListener('click', () => {
        form.querySelector('[name="Id"]').value = 0;
        form.querySelector('[name="Name"]').value = '';
        hex.value = '#FFFFFF'; picker.value = '#FFFFFF';
        document.getElementById('form-title').textContent = 'Thêm màu';
    });
</script>
}
