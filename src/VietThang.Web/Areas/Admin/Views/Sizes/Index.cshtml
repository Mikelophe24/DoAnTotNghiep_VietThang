@model VietThang.Web.ViewModels.Admin.SizeFormViewModel
@{
    ViewData["Title"] = "Kích cỡ";
    var sizes = (List<Size>)ViewBag.Sizes;
    var usage = (Dictionary<int, int>)ViewBag.UsageCounts;
}
<h1 class="h4 mb-3">Kích cỡ</h1>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>Size</th><th class="text-center">Thứ tự</th><th class="text-center">Biến thể dùng</th><th class="text-end" style="width:200px"></th></tr></thead>
                <tbody>
                @foreach (var s in sizes)
                {
                    <tr>
                        <td class="fw-semibold">@s.Name</td>
                        <td class="text-center">@s.DisplayOrder</td>
                        <td class="text-center">@(usage.TryGetValue(s.Id, out var n) ? n : 0)</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-edit-id="@s.Id" data-edit-name="@s.Name" data-edit-order="@s.DisplayOrder"><i class="bi bi-pencil"></i></button>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="Xóa size '@s.Name'?">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6" id="form-title">Thêm size</h2>
                <form asp-action="Save" method="post" id="size-form">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required"></label>
                        <input asp-for="Name" class="form-control" placeholder="VD: XL hoặc Size 3 (5-6 tuổi)" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>
                    <button class="btn btn-primary w-100" type="submit"><i class="bi bi-check-lg"></i> Lưu</button>
                    <button class="btn btn-link w-100 btn-sm" type="button" id="reset-form">Làm mới form</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    const form = document.getElementById('size-form');
    document.querySelectorAll('[data-edit-id]').forEach(btn => btn.addEventListener('click', () => {
        form.querySelector('[name="Id"]').value = btn.dataset.editId;
        form.querySelector('[name="Name"]').value = btn.dataset.editName;
        form.querySelector('[name="DisplayOrder"]').value = btn.dataset.editOrder;
        document.getElementById('form-title').textContent = 'Sửa size: ' + btn.dataset.editName;
    }));
    document.getElementById('reset-form').addEventListener('click', () => {
        form.querySelector('[name="Id"]').value = 0;
        form.querySelector('[name="Name"]').value = '';
        form.querySelector('[name="DisplayOrder"]').value = 0;
        document.getElementById('form-title').textContent = 'Thêm size';
    });
</script>
}
