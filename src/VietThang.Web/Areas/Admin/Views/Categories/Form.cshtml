@model VietThang.Web.ViewModels.Admin.CategoryFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa danh mục" : "Thêm danh mục";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required"></label>
                        <input asp-for="Name" class="form-control" data-slug-source />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" data-slug-target placeholder="Để trống sẽ tự sinh từ tên" />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="ParentId" class="form-label"></label>
                            <select asp-for="ParentId" asp-items="ViewBag.Parents" class="form-select">
                                <option value="">— Danh mục gốc —</option>
                            </select>
                            <span asp-validation-for="ParentId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <label asp-for="ImageFile" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2"><img src="@Model.ImageUrl" class="thumb-md" alt="" /></div>
                    }
                    <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                    <div class="form-text">JPG, PNG, WEBP tối đa 5MB.</div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-3"><i class="bi bi-check-lg"></i> @(isEdit ? "Lưu thay đổi" : "Thêm danh mục")</button>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
