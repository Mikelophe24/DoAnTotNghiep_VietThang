@model List<Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    var counts = (Dictionary<int, int>)ViewBag.ProductCounts;
    int CountOf(int id) => counts.TryGetValue(id, out var n) ? n : 0;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Danh mục sản phẩm</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm danh mục</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px"></th>
                    <th>Tên danh mục</th>
                    <th>Slug</th>
                    <th class="text-center">Thứ tự</th>
                    <th class="text-center">Sản phẩm</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:220px"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var root in Model)
            {
                <tr class="table-secondary">
                    <td>@if (!string.IsNullOrEmpty(root.ImageUrl)) { <img src="@root.ImageUrl" class="thumb-sm" alt="" /> }</td>
                    <td class="fw-semibold">@root.Name</td>
                    <td><code>@root.Slug</code></td>
                    <td class="text-center">@root.DisplayOrder</td>
                    <td class="text-center">@CountOf(root.Id)</td>
                    <td class="text-center">
                        <form asp-action="ToggleActive" asp-route-id="@root.Id" method="post" class="d-inline">
                            <button class="btn btn-sm @(root.IsActive ? "btn-success" : "btn-outline-secondary")">@(root.IsActive ? "Hiển thị" : "Đang ẩn")</button>
                        </form>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Create" asp-route-parentId="@root.Id" title="Thêm danh mục con"><i class="bi bi-plus"></i> Con</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@root.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@root.Id" method="post" class="d-inline" data-confirm="Xóa danh mục '@root.Name'?">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                @foreach (var child in root.Children.OrderBy(c => c.DisplayOrder).ThenBy(c => c.Name))
                {
                    <tr>
                        <td>@if (!string.IsNullOrEmpty(child.ImageUrl)) { <img src="@child.ImageUrl" class="thumb-sm" alt="" /> }</td>
                        <td class="ps-4"><i class="bi bi-arrow-return-right text-muted"></i> @child.Name</td>
                        <td><code>@child.Slug</code></td>
                        <td class="text-center">@child.DisplayOrder</td>
                        <td class="text-center">@CountOf(child.Id)</td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@child.Id" method="post" class="d-inline">
                                <button class="btn btn-sm @(child.IsActive ? "btn-success" : "btn-outline-secondary")">@(child.IsActive ? "Hiển thị" : "Đang ẩn")</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@child.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@child.Id" method="post" class="d-inline" data-confirm="Xóa danh mục '@child.Name'?">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Chưa có danh mục nào.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
