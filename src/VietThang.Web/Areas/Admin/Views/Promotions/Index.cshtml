@model List<Promotion>
@{
    ViewData["Title"] = "Khuyến mãi";
    var now = DateTime.Now;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Chương trình khuyến mãi</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Tạo chương trình</a>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Chương trình</th><th>Mức giảm</th><th>Thời gian</th><th class="text-center">Sản phẩm</th><th class="text-center">Trạng thái</th><th class="text-end" style="width:160px"></th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                var effective = p.IsActive && p.StartDate <= now && p.EndDate >= now;
                var label = !p.IsActive ? ("Tắt", "bg-secondary") : p.EndDate < now ? ("Hết hạn", "bg-dark") : p.StartDate > now ? ("Sắp diễn ra", "bg-info text-dark") : ("Đang chạy", "bg-success");
                <tr>
                    <td class="fw-semibold">@p.Name</td>
                    <td>@(p.DiscountType == DiscountType.Percent ? p.DiscountValue + "%" : p.DiscountValue.ToString("N0") + " đ")</td>
                    <td class="small">@p.StartDate.ToString("dd/MM/yyyy") → @p.EndDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">@p.PromotionProducts.Count</td>
                    <td class="text-center"><span class="badge @label.Item2">@label.Item1</span></td>
                    <td class="text-end">
                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" title="Bật/tắt"><i class="bi bi-power"></i></button></form>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirm="Xóa chương trình '@p.Name'?"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có chương trình khuyến mãi.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
