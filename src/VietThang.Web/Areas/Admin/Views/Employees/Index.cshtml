@model List<(ApplicationUser User, string Role)>
@{
    ViewData["Title"] = "Nhân viên & phân quyền";
    string me = ViewBag.CurrentUserId;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Nhân viên & phân quyền</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Thêm tài khoản</a>
</div>
<div class="card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light"><tr><th>Họ tên</th><th>Email đăng nhập</th><th>Điện thoại</th><th>Vai trò</th><th class="text-center">Trạng thái</th><th class="text-end" style="width:90px"></th></tr></thead>
        <tbody>
        @foreach (var (u, role) in Model)
        {
            <tr>
                <td class="fw-semibold">@u.FullName @(u.Id == me ? "(bạn)" : "")</td>
                <td>@u.Email</td>
                <td>@u.PhoneNumber</td>
                <td><span class="badge @(role == "Admin" ? "bg-dark" : "bg-primary")">@(role == "Admin" ? "Quản trị viên" : "Nhân viên")</span></td>
                <td class="text-center"><span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">@(u.IsActive ? "Hoạt động" : "Bị khóa")</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id"><i class="bi bi-pencil"></i></a></td>
            </tr>
        }
        </tbody>
    </table>
    <div class="card-footer small text-muted">Quản trị viên: toàn quyền. Nhân viên: sản phẩm, đơn hàng, kho, đánh giá, liên hệ, xem khách hàng.</div>
</div>
