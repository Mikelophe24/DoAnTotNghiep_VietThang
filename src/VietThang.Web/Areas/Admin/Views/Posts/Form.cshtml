@model PostFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa bài viết" : "Viết bài mới";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3"><label asp-for="Title" class="form-label required"></label><input asp-for="Title" class="form-control" data-slug-source /><span asp-validation-for="Title" class="text-danger small"></span></div>
                    <div class="mb-3"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" data-slug-target placeholder="Để trống sẽ tự sinh" /><span asp-validation-for="Slug" class="text-danger small"></span></div>
                    <div class="mb-3"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" class="form-control" rows="2"></textarea></div>
                    <div class="mb-0"><label asp-for="Content" class="form-label required"></label><textarea asp-for="Content" class="form-control" rows="16"></textarea><span asp-validation-for="Content" class="text-danger small"></span></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select"><option value="1">Tin tức</option><option value="2">Tuyển dụng</option></select></div>
                    <div class="form-check"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <label asp-for="ThumbnailFile" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl)) { <div class="mb-2"><img src="@Model.ThumbnailUrl" class="img-fluid rounded" alt="" /></div> }
                    <input asp-for="ThumbnailFile" type="file" accept="image/*" class="form-control" />
                </div>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> @(isEdit ? "Lưu thay đổi" : "Đăng bài")</button>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js"></script>
    <script>
        tinymce.init({ selector: '#Content', height: 480, menubar: false, plugins: 'lists link image table code', toolbar: 'undo redo | blocks | bold italic underline | bullist numlist | link image table | code', branding: false, promotion: false });
    </script>
}
