@model VietThang.Web.ViewModels.Admin.GoodsReceiptFormViewModel
@{
    ViewData["Title"] = "Lập phiếu nhập hàng";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Lập phiếu nhập hàng</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Danh sách</a>
</div>
<form asp-action="Create" method="post" class="card" style="max-width:640px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3"><label asp-for="SupplierId" class="form-label required"></label><select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select"><option value="">— Chọn nhà cung cấp —</option></select><span asp-validation-for="SupplierId" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="ReceiptDate" class="form-label"></label><input asp-for="ReceiptDate" class="form-control" /></div>
        <div class="mb-0"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="card-footer"><button class="btn btn-primary"><i class="bi bi-arrow-right"></i> Tạo phiếu và thêm dòng hàng</button></div>
</form>
@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
