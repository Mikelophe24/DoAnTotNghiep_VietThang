@model BannerFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa banner" : "Thêm banner";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="card" style="max-width:760px">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" alt="" /> }
        <div class="mb-3"><label asp-for="ImageFile" class="form-label @(isEdit ? "" : "required")"></label><input asp-for="ImageFile" type="file" accept="image/*" class="form-control" /><span asp-validation-for="ImageFile" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="mb-3"><label asp-for="LinkUrl" class="form-label"></label><input asp-for="LinkUrl" class="form-control" placeholder="/danh-muc/nu hoặc /sale" /></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Position" class="form-label"></label><select asp-for="Position" class="form-select"><option value="1">Slider trang chủ</option><option value="2">Giữa trang chủ</option><option value="3">Đầu trang danh mục</option></select></div>
            <div class="col-md-6 mb-3"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
        </div>
        <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="card-footer"><button class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button></div>
</form>
@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
