@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}
<div class="container mt-3">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_CustomerNav" /></div>
        <div class="col-lg-9">
            <h1 class="h4 mb-3">Hồ sơ của tôi</h1>
            <form asp-action="Profile" method="post" class="bg-white border rounded p-4" style="max-width:640px">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3"><label asp-for="FullName" class="form-label required"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly /></div>
                <div class="mb-3"><label asp-for="PhoneNumber" class="form-label required"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select"><option value="">— Chọn —</option><option value="2">Nữ</option><option value="1">Nam</option><option value="0">Khác</option></select></div>
                    <div class="col-md-6 mb-3"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-brand"><i class="bi bi-check-lg"></i> Lưu thay đổi</button>
                    <a class="btn btn-outline-secondary" asp-action="ChangePassword"><i class="bi bi-key"></i> Đổi mật khẩu</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
