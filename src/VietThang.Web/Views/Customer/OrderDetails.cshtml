@model Order
@{
    ViewData["Title"] = "Đơn " + Model.OrderCode;
    var reviewed = (List<int>)ViewBag.ReviewedProductIds;
    var variantProduct = (Dictionary<int, int>)ViewBag.VariantProductIds;
}
<div class="container mt-3">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_CustomerNav" /></div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h4 mb-0">Chi tiết đơn hàng</h1>
                <a class="btn btn-outline-secondary btn-sm" asp-action="Orders"><i class="bi bi-arrow-left"></i> Danh sách</a>
            </div>
            <div class="bg-white border rounded p-4">
                <partial name="~/Views/Orders/_OrderDetails.cshtml" model="Model" />
                @if (Model.Status == OrderStatus.Pending)
                {
                    <form asp-action="CancelOrder" asp-route-code="@Model.OrderCode" method="post" class="mt-3 d-flex gap-2" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?')">
                        <input name="reason" class="form-control" placeholder="Lý do hủy (không bắt buộc)" maxlength="200" />
                        <button class="btn btn-outline-danger text-nowrap"><i class="bi bi-x-circle"></i> Hủy đơn</button>
                    </form>
                }
            </div>

            @if (Model.Status == OrderStatus.Completed)
            {
                <div class="bg-white border rounded p-4 mt-3">
                    <h2 class="h6 mb-3">Đánh giá sản phẩm đã mua</h2>
                    @foreach (var d in Model.Details.DistinctBy(d => variantProduct.GetValueOrDefault(d.VariantId)))
                    {
                        var productId = variantProduct.GetValueOrDefault(d.VariantId);
                        <div class="border-bottom pb-3 mb-3">
                            <div class="fw-semibold">@d.ProductName</div>
                            @if (reviewed.Contains(productId))
                            {
                                <div class="small text-success"><i class="bi bi-check-circle"></i> Bạn đã đánh giá sản phẩm này.</div>
                            }
                            else
                            {
                                <form asp-action="Review" asp-route-code="@Model.OrderCode" method="post" class="row g-2 align-items-start mt-1">
                                    <input type="hidden" name="ProductId" value="@productId" />
                                    <input type="hidden" name="OrderId" value="@Model.Id" />
                                    <div class="col-auto">
                                        <select name="Rating" class="form-select form-select-sm">
                                            <option value="5">★★★★★ Tuyệt vời</option><option value="4">★★★★ Hài lòng</option><option value="3">★★★ Bình thường</option><option value="2">★★ Chưa tốt</option><option value="1">★ Tệ</option>
                                        </select>
                                    </div>
                                    <div class="col"><input name="Comment" class="form-control form-control-sm" placeholder="Chia sẻ cảm nhận về chất vải, form dáng..." maxlength="1000" /></div>
                                    <div class="col-auto"><button class="btn btn-sm btn-brand">Gửi đánh giá</button></div>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
