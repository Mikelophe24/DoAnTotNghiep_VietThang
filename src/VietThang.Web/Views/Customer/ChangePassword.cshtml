@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<div class="container mt-3">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_CustomerNav" /></div>
        <div class="col-lg-9">
            <h1 class="h4 mb-3">Đổi mật khẩu</h1>
            <form asp-action="ChangePassword" method="post" class="bg-white border rounded p-4" style="max-width:480px">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" /><span asp-validation-for="CurrentPassword" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                <button class="btn btn-brand"><i class="bi bi-check-lg"></i> Đổi mật khẩu</button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
