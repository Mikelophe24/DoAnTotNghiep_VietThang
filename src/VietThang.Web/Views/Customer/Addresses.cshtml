@model List<Address>
@{
    ViewData["Title"] = "Sổ địa chỉ";
}
<div class="container mt-3">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_CustomerNav" /></div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h4 mb-0">Sổ địa chỉ</h1>
                <a class="btn btn-brand" asp-action="AddressForm"><i class="bi bi-plus-lg"></i> Thêm địa chỉ</a>
            </div>
            @if (!Model.Any()) { <p class="text-muted">Bạn chưa lưu địa chỉ nào.</p> }
            <div class="row g-3">
                @foreach (var a in Model)
                {
                    <div class="col-md-6">
                        <div class="bg-white border rounded p-3 h-100 @(a.IsDefault ? "border-primary" : "")">
                            <div class="d-flex justify-content-between">
                                <strong>@a.ReceiverName</strong>
                                @if (a.IsDefault) { <span class="badge bg-primary">Mặc định</span> }
                            </div>
                            <div class="small">@a.Phone</div>
                            <div class="small text-muted">@a.FullAddress</div>
                            <div class="d-flex gap-2 mt-2">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="EditAddress" asp-route-id="@a.Id">Sửa</a>
                                @if (!a.IsDefault)
                                {
                                    <form asp-action="SetDefaultAddress" asp-route-id="@a.Id" method="post"><button class="btn btn-sm btn-outline-primary">Đặt mặc định</button></form>
                                }
                                <form asp-action="DeleteAddress" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Xóa địa chỉ này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
