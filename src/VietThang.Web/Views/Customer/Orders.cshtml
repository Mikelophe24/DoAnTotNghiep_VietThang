@model PagedList<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<div class="container mt-3">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_CustomerNav" /></div>
        <div class="col-lg-9">
            <h1 class="h4 mb-3">Đơn hàng của tôi</h1>
            @if (!Model.Items.Any())
            {
                <div class="bg-white border rounded p-5 text-center text-muted">Bạn chưa có đơn hàng nào. <a asp-controller="Home" asp-action="Index">Mua sắm ngay</a></div>
            }
            else
            {
                <div class="bg-white border rounded">
                    <table class="table mb-0 align-middle">
                        <thead class="table-light"><tr><th>Mã đơn</th><th>Ngày đặt</th><th class="text-center">Sản phẩm</th><th class="text-end">Tổng tiền</th><th class="text-center">Trạng thái</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var o in Model.Items)
                        {
                            <tr>
                                <td><a asp-action="OrderDetails" asp-route-code="@o.OrderCode" class="fw-semibold">@o.OrderCode</a></td>
                                <td class="small">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">@o.Details.Sum(d => d.Quantity)</td>
                                <td class="text-end fw-semibold">@o.TotalAmount.ToVnd()</td>
                                <td class="text-center"><span class="badge @o.Status.ToBadgeClass()">@o.Status.ToDisplay()</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="OrderDetails" asp-route-code="@o.OrderCode">Chi tiết</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3"><ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.PageIndex ? "active" : "")"><a class="page-link" href="@Context.Request.WithPage(i)">@i</a></li> }
                    </ul></nav>
                }
            }
        </div>
    </div>
</div>
