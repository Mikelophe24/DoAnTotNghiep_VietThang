@model VietThang.Web.Models.ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Có lỗi xảy ra - Việt Thắng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container text-center my-5">
        <h1 class="display-6 text-danger">Có lỗi xảy ra</h1>
        <p class="lead">Hệ thống gặp sự cố khi xử lý yêu cầu. Vui lòng thử lại sau.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" href="/Admin">Về trang quản trị</a>
    </div>
</body>
</html>
